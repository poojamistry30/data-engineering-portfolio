{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactorysapproject"
		},
		"ls_adls_bronze_dev_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_bronze_dev'"
		},
		"ls_sqldb_watermark_dev_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqldb_watermark_dev'"
		},
		"ls_filesystem_src_dev_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_filesystem_src_dev'"
		},
		"ls_adls_bronze_dev_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsstorage30.dfs.core.windows.net/"
		},
		"ls_sqldb_watermark_dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver307.database.windows.net"
		},
		"ls_sqldb_watermark_dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-p2p-free-dev"
		},
		"ls_sqldb_watermark_dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "pooja"
		},
		"ls_filesystem_src_dev_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\Users\\POOJA MISTRY\\Documents\\Azure Project\\Files"
		},
		"ls_filesystem_src_dev_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": ".\\pooja mistry"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_bronze_dev')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_bronze_dev_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_adls_bronze_dev_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_sqldb_watermark_dev')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sqldb_watermark_dev_properties_typeProperties_server')]",
					"database": "[parameters('ls_sqldb_watermark_dev_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sqldb_watermark_dev_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_sqldb_watermark_dev_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/IR-SHIR-ONPREM-ADLSDEV')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_filesystem_src_dev')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "FileServer",
				"typeProperties": {
					"host": "[parameters('ls_filesystem_src_dev_properties_typeProperties_host')]",
					"userId": "[parameters('ls_filesystem_src_dev_properties_typeProperties_userId')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_filesystem_src_dev_password')]"
					}
				},
				"connectVia": {
					"referenceName": "IR-SHIR-ONPREM-ADLSDEV",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/IR-SHIR-ONPREM-ADLSDEV')]"
			]
		}
	]
}